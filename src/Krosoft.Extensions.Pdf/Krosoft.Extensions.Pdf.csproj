<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PackageTags>Krosoft Extension Pdf</PackageTags>
		<Description>Package pour faciliter l'utilisation des PDF.</Description>
	</PropertyGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
		<!-- Remplace la version 8.0.1 vulnérable tirée par PDFsharp (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx) -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Krosoft.Extensions.Core" Version="2026.9.12.10423" />
		<PackageReference Include="PDFsharp" Version="6.2.4" />
	</ItemGroup>
</Project>